#!/bin/sh
# Runs hook.ts with whichever TypeScript runtime the machine has.
# A missing runtime exits 0 so the plugin never blocks the user's prompt.
script="$(dirname "$0")/hook.ts"
for runtime in bun node; do
  if command -v "$runtime" >/dev/null 2>&1; then
    exec "$runtime" "$script" "$@"
  fi
done
echo "onyx plugin: bun or node 23.6+ is required to run its hooks" >&2
exit 0
