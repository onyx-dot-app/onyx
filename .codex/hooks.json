{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/pre_commit_on_stop.py\"",
            "timeout": 600,
            "statusMessage": "Run pre-commit on the files this turn changed"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/pre_commit_on_stop.py\"",
            "timeout": 60,
            "statusMessage": "Record the files this turn starts with"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/opal_migrate_on_edit.py\"",
            "timeout": 30,
            "statusMessage": "Check the edited web files for Opal migrations"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/component_catalog_on_new_file.py\"",
            "timeout": 10,
            "statusMessage": "Point new web components at the component catalog"
          }
        ]
      }
    ]
  }
}
