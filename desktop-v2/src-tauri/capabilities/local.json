{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-windows",
  "description": "Bundled local windows only. The main window shows the remote server UI and gets no IPC.",
  "local": true,
  "windows": [
    "onboarding",
    "login",
    "preferences"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-check-server",
    "allow-save-server",
    "allow-login",
    "allow-get-prefs",
    "allow-change-server",
    "allow-sign-out",
    "allow-open-external"
  ]
}
