{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preferences",
  "description": "The Preferences window: server, launcher shortcut and sign-out.",
  "local": true,
  "windows": ["preferences"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-get-prefs",
    "allow-set-hotkey",
    "allow-set-launch-at-login",
    "allow-set-notify-answers",
    "allow-change-server",
    "allow-sign-out"
  ]
}
