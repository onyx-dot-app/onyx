<?xml version="1.0" encoding="utf-8"?>
<!-- Linked into the MSI through bundle.windows.wix.componentGroupRefs. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- The NSIS installer's uninstall entry. Both installers use the same
             folder, so the MSI refuses to install beside an NSIS install. -->
        <Property Id="ONYX_NSIS_INSTALL">
            <RegistrySearch Id="OnyxNsisInstall"
                            Root="HKLM"
                            Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Onyx v2"
                            Name="UninstallString"
                            Type="raw"
                            Win64="yes" />
        </Property>
        <Condition Message="Onyx v2 is already installed from the setup program (.exe). Uninstall it in Settings &gt; Apps, then run this installer again.">
            <![CDATA[Installed OR NOT ONYX_NSIS_INSTALL]]>
        </Condition>

        <!-- The Finish page's "Launch" checkbox. The template's action starts
             the file by its File table key, which fails from the UI (Return
             value 1631). WixShellExec starts the resolved path. A fragment
             cannot remove or reorder the template's Publish row, so both
             actions run; the template's starts nothing. In the log, "Return
             value 1" for OnyxLaunchApp means success. -->
        <Property Id="WixShellExecTarget" Value="[#Path]" />
        <CustomAction Id="OnyxLaunchApp" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
        <UI>
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OnyxLaunchApp">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>

        <!-- "msiexec /x ... DELETEAPPDATA=1" deletes the app's data folders of
             the user who runs msiexec, as that user, as the NSIS option "Delete
             the application data" does. As LocalSystem (SCCM, Intune) it does
             nothing: the folders belong to users who can replace them with
             links. It also deletes that user's session tokens from Credential
             Manager. The command is
             delete-user-data.ps1, as UTF-16LE in base64. -->
        <Property Id="DELETEAPPDATA" Secure="yes" />
        <!-- A private property (lower-case letters), so a command line cannot
             change it. -->
        <Property Id="OnyxDeleteUserDataArgs" Value="-NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand " />
        <!-- A commit action runs only after the uninstall cannot roll back
             any more, so a cancelled uninstall keeps the data. With rollback
             disabled, commit actions do not run; the deferred copy runs then. -->
        <CustomAction Id="OnyxDeleteUserData"
                      Directory="TARGETDIR"
                      Execute="commit"
                      Impersonate="yes"
                      Return="ignore"
                      ExeCommand='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" [OnyxDeleteUserDataArgs]' />
        <CustomAction Id="OnyxDeleteUserDataNoRollback"
                      Directory="TARGETDIR"
                      Execute="deferred"
                      Impersonate="yes"
                      Return="ignore"
                      ExeCommand='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" [OnyxDeleteUserDataArgs]' />
        <InstallExecuteSequence>
            <Custom Action="OnyxDeleteUserData" Before="InstallFinalize"><![CDATA[REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE AND DELETEAPPDATA="1" AND NOT RollbackDisabled]]></Custom>
            <Custom Action="OnyxDeleteUserDataNoRollback" Before="InstallFinalize"><![CDATA[REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE AND DELETEAPPDATA="1" AND RollbackDisabled]]></Custom>
        </InstallExecuteSequence>

        <ComponentGroup Id="OnyxInstallerGuards" />
    </Fragment>
</Wix>
