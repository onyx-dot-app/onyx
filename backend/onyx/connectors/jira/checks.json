{
  "source": "jira",
  "nodes": [
    {
      "id": "jira_auth",
      "display_name": "Sign in to Jira",
      "requires_connector_instance": false,
      "requires_fields": [
        "jira_base_url"
      ],
      "remediation": "Jira Cloud: enter the email of the token's Atlassian account and an API token. Jira Data Center: leave the email empty and use a personal access token. Check the site URL, and create a new token if it expired.",
      "docs_link": "https://docs.onyx.app/admins/connectors/official/jira",
      "validates_binding": true,
      "fails_when_unreachable": true
    },
    {
      "id": "jira_scoped_token_auth",
      "display_name": "Sign in to Jira",
      "requires_connector_instance": false,
      "requires_fields": [
        "jira_base_url"
      ],
      "remediation": "Scoped API tokens work only with Jira Cloud. Enter the email of the token's Atlassian account with the token, check the site URL, and create a new token if it expired.",
      "docs_link": "https://docs.onyx.app/admins/connectors/official/jira",
      "validates_binding": true,
      "fails_when_unreachable": true,
      "row_id": "jira_auth"
    },
    {
      "id": "jira_projects_visible",
      "display_name": "List projects",
      "requires_connector_instance": false,
      "requires_fields": [
        "jira_base_url"
      ],
      "remediation": "Give the token's account the Browse Projects permission on the projects to index. Scoped API token: the `read:jira-work` scope.",
      "docs_link": "https://docs.onyx.app/admins/connectors/official/jira",
      "validates_binding": true,
      "depends_on": [
        "jira_auth",
        "jira_scoped_token_auth"
      ]
    },
    {
      "id": "jira_configured_project",
      "display_name": "Find selected project",
      "requires_connector_instance": false,
      "requires_fields": [
        "jira_base_url"
      ],
      "remediation": "Use the project key, not the project name (e.g. `PROJ`), and give the token's account Browse Projects on the project.",
      "docs_link": "https://docs.onyx.app/admins/connectors/official/jira",
      "depends_on": [
        "jira_projects_visible"
      ]
    },
    {
      "id": "jira_jql_query",
      "display_name": "Run JQL query",
      "requires_connector_instance": false,
      "requires_fields": [
        "jira_base_url"
      ],
      "remediation": "Test the query in Jira's issue search. Quote values that are reserved JQL words (e.g. project = \"AS\"). Use no ORDER BY.",
      "docs_link": "https://docs.onyx.app/admins/connectors/official/jira",
      "depends_on": [
        "jira_projects_visible"
      ]
    },
    {
      "id": "jira_issue_read",
      "display_name": "Sample issues",
      "requires_connector_instance": false,
      "requires_fields": [
        "jira_base_url"
      ],
      "remediation": "Give the token's account Browse Projects on the projects to index, and access to their issue security levels. Scoped API token: the `read:jira-work` scope.",
      "docs_link": "https://docs.onyx.app/admins/connectors/official/jira",
      "depends_on": [
        "jira_projects_visible",
        "jira_configured_project",
        "jira_jql_query"
      ]
    }
  ]
}
