<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>Onyx Desktop</displayName>
  <description>Settings for the Onyx desktop app.</description>
  <resources>
    <stringTable>
      <string id="Onyx">Onyx</string>
      <string id="OnyxDesktop">Onyx Desktop</string>
      <string id="SUPPORTED_OnyxDesktop">Onyx desktop app versions that read managed policy</string>
      <string id="ServerURL">Onyx server</string>
      <string id="ServerURL_Explain">The Onyx server that the app connects to, for example https://onyx.example.com. http:// is allowed for an intranet server. If the user has not saved a server, the app skips onboarding. A server that the user saves later is used instead, unless "Lock the Onyx server" is enabled. The app keeps only the scheme, host and port, so Onyx must run at the server root. A URL with a user name or password is not valid.</string>
      <string id="LockServerURL">Lock the Onyx server</string>
      <string id="LockServerURL_Explain">If enabled, the app always uses the server in "Onyx server", and the user cannot change it. If "Onyx server" is not set or not valid, the app uses the last valid "Onyx server" it had, else the user's saved server, and the user cannot change it. Applies at the next launch.</string>
      <string id="DisableAutoUpdate">Turn off automatic updates</string>
      <string id="DisableAutoUpdate_Explain">Has no effect on Windows: Windows builds do not update themselves. Deploy new versions with your management tool. On macOS, the app does not check for, download or install updates when this is enabled.</string>
      <string id="LauncherShortcut">Launcher shortcut</string>
      <string id="LauncherShortcut_Explain">The keyboard shortcut that opens the launcher, for example CommandOrControl+Shift+Space. The user cannot change it.</string>
      <string id="DisableLauncher">Turn off the launcher</string>
      <string id="DisableLauncher_Explain">If enabled, the app registers no launcher shortcut, the launcher does not open, and "Open Launcher" in the menus is turned off.</string>
      <string id="LaunchAtLogin">Launch at login</string>
      <string id="LaunchAtLogin_Explain">If enabled, the app adds a login item for the user. If disabled, the app removes it. The user cannot change the setting in Preferences. This is best effort: the user can turn the item off in Task Manager. To force the app to start, add it to HKLM\Software\Microsoft\Windows\CurrentVersion\Run.</string>
      <string id="DisableNotifications">Turn off notifications</string>
      <string id="DisableNotifications_Explain">If enabled, the app shows no desktop notifications.</string>
    </stringTable>
    <presentationTable>
      <presentation id="ServerURL">
        <textBox refId="ServerURL">
          <label>Server URL:</label>
        </textBox>
      </presentation>
      <presentation id="LauncherShortcut">
        <textBox refId="LauncherShortcut">
          <label>Shortcut:</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
