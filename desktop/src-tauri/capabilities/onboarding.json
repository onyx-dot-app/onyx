{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onboarding",
  "description": "The onboarding window: check and save the server URL.",
  "local": true,
  "windows": ["onboarding"],
  "permissions": [
    "allow-release-window",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-fit-window",
    "allow-check-server",
    "allow-save-server",
    "allow-get-server-lock"
  ]
}
