{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "login",
  "description": "The sign-in window: password and SSO sign-in.",
  "local": true,
  "windows": ["login"],
  "permissions": [
    "allow-release-window",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-fit-window",
    "allow-get-prefs",
    "allow-get-auth-methods",
    "allow-login",
    "allow-sign-in-with-sso",
    "allow-change-server"
  ]
}
