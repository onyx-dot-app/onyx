    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: slack bot",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/onyx/onyxbot/slack/listener.py",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: discord bot",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/onyx/onyxbot/discord/client.py",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: background jobs",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_run_background_jobs.py",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: pytest",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--module",
      "pytest",
      "-v",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: pytest (current file)",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--module",
      "pytest",
      "-v",
      "$ZED_FILE",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
    "reevaluate_context": true,
  },
]
