  },
  {
    "label": "run: celery beat",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
