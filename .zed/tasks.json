// Zed port of .vscode/tasks.json, plus the .vscode/launch.json entries that
// were never really debug targets (docker, uv, db, openapi, dev servers).
//
// "ods-env" is referenced by the `build` field of configs in .zed/debug.json.
// Keep that label in sync.
//
// Run these with `task: spawn` from the command palette.
[
  // --- 1. Build Tasks (used by debug.json) ---
  {
    "label": "ods-env",
    "command": "uv",
    "args": ["run", "--with", "onyx-devtools", "ods", "env"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "hide": "on_success",
  },

  // --- 2. Docker ---
  {
    "label": "docker: start",
    "command": "docker",
    "args": [
      "compose",
      "-f",
      "docker-compose.yml",
      "-f",
      "docker-compose.dev.yml",
      "up",
      "-d",
      "relational_db",
      "opensearch",
      "cache",
      "minio",
      "code-interpreter",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
  },
  {
    "label": "docker: start (background)",
    "command": "docker",
    "args": [
      "compose",
      "-f",
      "docker-compose.yml",
      "-f",
      "docker-compose.dev.yml",
      "up",
      "-d",
      "--build",
      "background",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
  },
  {
    "label": "docker: stop",
    "command": "docker",
    "args": [
      "compose",
      "-f",
      "docker-compose.yml",
      "-f",
      "docker-compose.dev.yml",
      "stop",
      "relational_db",
      "opensearch",
      "cache",
      "minio",
      "code-interpreter",
      "background",
      "inference_model_server",
      "indexing_model_server",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
  },
  {
    "label": "docker: status",
    "command": "docker",
    "args": [
      "compose",
      "-f",
      "docker-compose.yml",
      "-f",
      "docker-compose.dev.yml",
      "ps",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
  },

  // --- 3. Backend ---
  {
    "label": "backend: install",
    "command": "uv",
    "args": ["sync", "--frozen"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },

  // --- 4. Web ---
  {
    "label": "web: install",
    "command": "bun",
    "args": ["i"],
    "cwd": "$ZED_WORKTREE_ROOT/web",
  },
  {
    "label": "web: install (forced)",
    "command": "set -e; rm -rf node_modules .next lib/opal/node_modules lib/opal/dist lib/shared/node_modules lib/shared/dist; bun i",
    "cwd": "$ZED_WORKTREE_ROOT/web",
  },

  // --- 5. Database ---
  {
    "label": "db: up",
    "command": "\"$ZED_WORKTREE_ROOT/.venv/bin/python\" -m dotenv -f \"$ZED_WORKTREE_ROOT/.vscode/.env\" run -- \"$ZED_WORKTREE_ROOT/.venv/bin/python\" -m alembic upgrade head",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
  },
  {
    "label": "db: down",
    "command": "\"$ZED_WORKTREE_ROOT/.venv/bin/python\" -m dotenv -f \"$ZED_WORKTREE_ROOT/.vscode/.env\" run -- \"$ZED_WORKTREE_ROOT/.venv/bin/python\" -m alembic downgrade base",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
  },
  {
    "label": "db: drop all",
    "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T relational_db psql -U postgres -d postgres -v ON_ERROR_STOP=1 -c 'DROP SCHEMA public CASCADE;'",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
  },
  {
    "label": "db: select ${ZED_SELECTED_TEXT}",
    "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T relational_db psql -U postgres -d postgres -P pager=off -c 'SELECT * FROM \"${ZED_SELECTED_TEXT}\" LIMIT 50;'",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
    "reevaluate_context": true,
  },
  {
    "label": "db: select (prompt)",
    "command": "printf 'Table: '; read t; docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T relational_db psql -U postgres -d postgres -P pager=off -c \"SELECT * FROM \\\"$t\\\" LIMIT 50;\"",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
    "use_new_terminal": true,
  },
  {
    "label": "db: describe ${ZED_SELECTED_TEXT}",
    "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T relational_db psql -U postgres -d postgres -P pager=off -c '\\d \"${ZED_SELECTED_TEXT}\"'",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
    "reevaluate_context": true,
  },
  {
    "label": "db: describe (prompt)",
    "command": "printf 'Table: '; read t; docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T relational_db psql -U postgres -d postgres -P pager=off -c \"\\\\d $t\"",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
    "use_new_terminal": true,
  },
  {
    "label": "db: tables",
    "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T relational_db psql -U postgres -d postgres -P pager=off -c '\\dt'",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
  },
  {
    "label": "db: shell",
    "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec relational_db psql -U postgres -d postgres",
    "cwd": "$ZED_WORKTREE_ROOT/deployment/docker_compose",
    "use_new_terminal": true,
  },
  {
    "label": "db: restore seeded database dump",
    "command": "uv",
    "args": [
      "run",
      "--with",
      "onyx-devtools",
      "ods",
      "db",
      "restore",
      "--fetch-seeded",
      "--yes",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "db: clean restore seeded database dump (destructive)",
    "command": "uv",
    "args": [
      "run",
      "--with",
      "onyx-devtools",
      "ods",
      "db",
      "restore",
      "--fetch-seeded",
      "--clean",
      "--yes",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "db: create database snapshot",
    "command": "uv",
    "args": [
      "run",
      "--with",
      "onyx-devtools",
      "ods",
      "db",
      "dump",
      "backup.dump",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "db: clean restore database snapshot (destructive)",
    "command": "uv",
    "args": [
      "run",
      "--with",
      "onyx-devtools",
      "ods",
      "db",
      "restore",
      "--clean",
      "--yes",
      "backup.dump",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },

  // --- 6. Run (no debugger) ---
  {
    "label": "run: web",
    "command": "bun",
    "args": ["run", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT/web",
  },
  {
    "label": "run: browser",
    "command": "open",
    "args": ["-a", "Dia", "http://localhost:3000"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "run: api",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--module",
      "uvicorn",
      "onyx.main:app",
      "--reload",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/skills/builtin",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/server/features/build/sandbox/image",
      "--port",
      "8080",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
    },
  },
  {
    "label": "run: model",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--module",
      "uvicorn",
      "model_server.main:app",
      "--reload",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/skills/builtin",
      "--port",
      "9000",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
    },
  },
  {
    "label": "run: mcp",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--module",
      "uvicorn",
      "onyx.mcp_server.api:mcp_app",
      "--reload",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/skills/builtin",
      "--port",
      "8090",
      "--timeout-graceful-shutdown",
      "0",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "MCP_SERVER_ENABLED": "true",
      "MCP_SERVER_PORT": "8090",
      "MCP_SERVER_CORS_ORIGINS": "http://localhost:*",
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
    },
  },
  {
    "label": "run: celery primary",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.primary",
      "worker",
      "--pool=threads",
      "--concurrency=4",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=primary@%n",
      "-Q",
      "celery",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "INFO",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery light",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.light",
      "worker",
      "--pool=threads",
      "--concurrency=64",
      "--prefetch-multiplier=8",
      "--loglevel=INFO",
      "--hostname=light@%n",
      "-Q",
      "vespa_metadata_sync,connector_deletion,doc_permissions_upsert,checkpoint_cleanup,index_attempt_cleanup,opensearch_migration",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "INFO",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery heavy",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.heavy",
      "worker",
      "--pool=threads",
      "--concurrency=4",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=heavy@%n",
      "-Q",
      "connector_pruning,connector_doc_permissions_sync,connector_external_group_sync,csv_generation,sandbox",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "INFO",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery monitoring",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.monitoring",
      "worker",
      "--pool=threads",
      "--concurrency=1",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=monitoring@%n",
      "-Q",
      "monitoring",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "INFO",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery user_file_processing",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.user_file_processing",
      "worker",
      "--pool=threads",
      "--concurrency=2",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=user_file_processing@%n",
      "-Q",
      "user_file_processing,user_file_project_sync,user_file_delete,user_file_port",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "INFO",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery scheduled_tasks",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.scheduled_tasks",
      "worker",
      "--pool=threads",
      "--concurrency=4",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=scheduled_tasks@%n",
      "-Q",
      "scheduled_tasks",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "INFO",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery docfetching",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.docfetching",
      "worker",
      "--pool=threads",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=docfetching@%n",
      "-Q",
      "connector_doc_fetching",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
    },
  },
  {
    "label": "run: celery docprocessing",
    "command": "$ZED_WORKTREE_ROOT/.venv/bin/python",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
      ".vscode/.env",
      "--program",
      "$ZED_WORKTREE_ROOT/backend/scripts/dev_celery_reload.py",
      "-A",
      "onyx.background.celery.versioned_apps.docprocessing",
      "worker",
      "--pool=threads",
      "--prefetch-multiplier=1",
      "--loglevel=INFO",
      "--hostname=docprocessing@%n",
      "-Q",
      "docprocessing,port",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "env": {
      "ENABLE_MULTIPASS_INDEXING": "false",
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
      "PYTHONPATH": ".",
