// Zed port of .vscode/launch.json
//
// Two things differ from VS Code and shape everything below:
//
//   1. debugpy has no `envFile`. That field belongs to the VS Code Python
//      extension, not to debugpy, so Zed ignores it. Every Python config here
//      launches through .zed/dotenv_launch.py, which loads the env file
//      in-process and then runs the real target in that same process.
//      Layout: [<env-file>, --module <name> | --program <path>, ...real args]
//
//   2. Zed has no `compounds`. Start the services you want from the debug
//      panel; Zed runs multiple sessions at once. The Docker dependencies
//      start from tasks.json: "docker: start".
//
//   Daily driver: "API Server" + "Model Server". Everything else is on demand.
//
// `preLaunchTask` maps to `build`, which refers to a label in .zed/tasks.json.
[
  // --- Servers ---
  {
    "label": "web",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/web",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["run", "--env-file=../.vscode/.env.web", "dev"],
    // Next spawns short-lived Turbopack children. With auto-attach on, each one
    // gets its own debug session; when a child exits, Zed tears down the whole
    // session tree and SIGKILLs `next dev`. Attach to the parent only.
    "autoAttachChildProcesses": false,
  },
  {
    "label": "api",
    "adapter": "Debugpy",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "program": "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
    "build": "ods-env",
    "args": [
      ".vscode/.env",
      "--module",
      "uvicorn",
      "onyx.main:app",
      "--reload",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/skills/builtin",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/server/features/build/sandbox/image",
      "--port",
      "8080",
    ],
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
    },
    "justMyCode": false,
  },
  {
    "label": "model",
    "adapter": "Debugpy",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "program": "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
    "args": [
      ".vscode/.env",
      "--module",
      "uvicorn",
      "model_server.main:app",
      "--reload",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/skills/builtin",
      "--port",
      "9000",
    ],
    "env": {
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
    },
  },
  {
    "label": "mcp",
    "adapter": "Debugpy",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "program": "$ZED_WORKTREE_ROOT/.zed/dotenv_launch.py",
    "args": [
      ".vscode/.env",
      "--module",
      "uvicorn",
      "onyx.mcp_server.api:mcp_app",
      "--reload",
      "--reload-exclude",
      "$ZED_WORKTREE_ROOT/backend/onyx/skills/builtin",
      "--port",
      "8090",
      "--timeout-graceful-shutdown",
      "0",
    ],
    "env": {
      "MCP_SERVER_ENABLED": "true",
      "MCP_SERVER_PORT": "8090",
      "MCP_SERVER_CORS_ORIGINS": "http://localhost:*",
      "LOG_LEVEL": "DEBUG",
      "PYTHONUNBUFFERED": "1",
    },
  },

