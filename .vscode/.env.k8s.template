# Personal overrides for local Kubernetes development.
# Copy to .vscode/.env.k8s, or let make craft-up create it.
# This file is private, gitignored, and is never rewritten at launch.
#
# The shared launcher reads the deployed API container's ConfigMaps, Secret
# references, and inline env settings. Service hosts, credentials, encryption,
# storage endpoints, sandbox image, and callback URL follow the Helm release.
# Resolved secrets stay in process memory. They are not written to this file.
#
# Values below override the deployed defaults. Leave cluster connection keys
# absent to follow cluster changes. K8S_CONTEXT, SANDBOX_BACKEND, and
# SANDBOX_NAMESPACE are pinned to the selected local environment by the launcher.

SKIP_WARM_UP=true
REQUIRE_EMAIL_VERIFICATION=false
LOG_LEVEL=DEBUG
LOG_DANSWER_MODEL_INTERACTIONS=false
DEV_LOGGING_ENABLED=true
PYTHONUNBUFFERED=1

# Model credentials can instead be configured in the application's admin UI.
# Placeholder values are ignored by the launcher.
GEN_AI_API_KEY=<REPLACE THIS>
GEN_AI_MODEL_VERSION=gpt-5.5
FAST_GEN_AI_MODEL_VERSION=gpt-5-mini

# Optional local overrides:
# ENABLE_OPENCODE_DEBUGGING=true
# OPENAI_API_KEY=<REPLACE THIS>
# ANTHROPIC_API_KEY=<REPLACE THIS>
# GEMINI_API_KEY=<REPLACE THIS>
# EXA_API_KEY=<REPLACE THIS>
# LOG_LEVEL=INFO
